{
  "request": {
    "method": "POST",
    "path": "/api/metadata/workflow",
    "body": {
      "name": "archon_fork",
      "version": 1,
      "schemaVersion": 2,
      "description": "FORK_JOIN with two branches and a JOIN",
      "timeoutPolicy": "ALERT_ONLY",
      "timeoutSeconds": 0,
      "tasks": [
        {
          "name": "fork",
          "taskReferenceName": "fork_ref",
          "type": "FORK_JOIN",
          "forkTasks": [
            [
              {
                "name": "archon_task_a",
                "taskReferenceName": "branch_a_ref",
                "type": "SIMPLE"
              }
            ],
            [
              {
                "name": "archon_task_b",
                "taskReferenceName": "branch_b_ref",
                "type": "SIMPLE"
              }
            ]
          ]
        },
        {
          "name": "join",
          "taskReferenceName": "join_ref",
          "type": "JOIN",
          "joinOn": [
            "branch_a_ref",
            "branch_b_ref"
          ]
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "content_type": null,
    "body": null
  }
}
