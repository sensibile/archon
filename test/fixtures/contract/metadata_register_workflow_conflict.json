{
  "request": {
    "method": "POST",
    "path": "/api/metadata/workflow",
    "body": {
      "name": "archon_simple",
      "version": 1,
      "schemaVersion": 2,
      "description": "Two sequential SIMPLE tasks",
      "inputParameters": [
        "x"
      ],
      "outputParameters": {
        "y": "${task_b_ref.output.y}"
      },
      "timeoutPolicy": "ALERT_ONLY",
      "timeoutSeconds": 0,
      "tasks": [
        {
          "name": "archon_task_a",
          "taskReferenceName": "task_a_ref",
          "type": "SIMPLE",
          "inputParameters": {
            "x": "${workflow.input.x}"
          }
        },
        {
          "name": "archon_task_b",
          "taskReferenceName": "task_b_ref",
          "type": "SIMPLE",
          "inputParameters": {
            "a": "${task_a_ref.output.y}"
          }
        }
      ]
    }
  },
  "response": {
    "status": 409,
    "content_type": "application/json",
    "body": {
      "status": 409,
      "message": "Workflow with archon_simple.1 already exists!",
      "instance": "<redacted-hostname>",
      "retryable": false
    }
  }
}
