{
  "request": {
    "method": "POST",
    "path": "/api/metadata/workflow",
    "body": {
      "name": "archon_p7_set_variable_fork",
      "version": 1,
      "schemaVersion": 2,
      "timeoutPolicy": "ALERT_ONLY",
      "timeoutSeconds": 0,
      "tasks": [
        {
          "name": "archon_p7_fork",
          "taskReferenceName": "fork_ref",
          "type": "FORK_JOIN",
          "forkTasks": [
            [
              {
                "name": "archon_p7_set",
                "taskReferenceName": "set_ref",
                "type": "SET_VARIABLE",
                "inputParameters": {
                  "v": "${workflow.input.v}"
                }
              }
            ],
            [
              {
                "name": "archon_p7_worker",
                "taskReferenceName": "worker_ref",
                "type": "SIMPLE"
              }
            ]
          ]
        },
        {
          "name": "archon_p7_join",
          "taskReferenceName": "join_ref",
          "type": "JOIN",
          "joinOn": [
            "set_ref",
            "worker_ref"
          ]
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "content_type": null,
    "body": null
  }
}
